{
  "manifest_version": 3,
  "name": "Coursera Auto Solver",
  "version": "1.1.0",
  "description": "An AI-powered extension to instantly auto-complete Coursera videos, readings, and automatically solve quizzes.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.coursera.org/learn/*"
      ],
      "js": [
        "course-requirements.js",
        "assessment-parser.js",
        "coursera-api.js",
        "coursera-state.js",
        "monaco-bridge.js",
        "presentation.js",
        "read-message-router.js",
        "content.js",
        "content-adapters.js"
      ]
    },
    {
      "run_at": "document_start",
      "matches": [
        "*://*.coursera.org/learn/*"
      ],
      "js": [
        "intercept-policy.js",
        "intercept.js"
      ],
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "*://*.coursera.org/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.x.ai/*",
    "https://api.deepseek.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coursera Auto Solver",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
